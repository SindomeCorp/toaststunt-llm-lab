# Command examples, not a configuration file. Run each example separately
# from the repository directory, as needed.

# Seed a fresh checkout from a consistent checkpoint of an existing game.
# Omit MOO_SEED_DB on later runs and keep using --server-only.
MOO_PORT=7788 MOO_SEED_DB=/absolute/path/to/world.db ./setup.sh --server-only

# Update only the engine to origin/master, build, then restart the service.
./update-toaststunt.sh

# Use a specific upstream tag or commit instead.
./update-toaststunt.sh v2.8.0

# Run a separate lab from a fresh checkout on a different port.
TOASTSTUNT_LAB_INSTANCE=test MOO_PORT=7789 ./setup.sh --register-codex
